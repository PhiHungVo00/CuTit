{
  "name": "@vietlearning/ui",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./agent-blocks": {
      "types": "./dist/agent-blocks/index.d.ts",
      "default": "./dist/agent-blocks/index.js"
    },
