  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^25.0.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
