{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "passThroughEnv": [
        "CI"
      ],
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "lint": {}
  }
}
