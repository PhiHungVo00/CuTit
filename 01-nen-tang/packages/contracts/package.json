{
  "name": "@vietlearning/contracts",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./a8": {
      "types": "./dist/a8/sentenceOrder.d.ts",
      "default": "./dist/a8/sentenceOrder.js"
    },
    "./db": {
      "types": "./dist/db/schema.d.ts",
      "default": "./dist/db/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@vietlearning/content": "workspace:*",
    "postgres": "^3.4.9",
    "typescript": "^5.7.3"
  }
}
