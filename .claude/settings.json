{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/chan-sua-migration.mjs\"",
            "timeout": 15,
            "statusMessage": "Kiểm tra migration đã phát hành"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/chan-commit-agents-turbo.mjs\"",
            "timeout": 15,
            "statusMessage": "Kiểm tra AGENTS.md trước commit"
          }
        ]
      }
    ]
  }
}
