# ==============================================================================
# HỆ THỐNG AGENTIC VIETNAMESE LEARNING - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép tệp này sang apps/gateway/.env và điền các giá trị thực tế
# ==============================================================================

# CỔNG GATEWAY
NODE_ENV=development
PORT=4000
# Danh sách origin được phép gọi Gateway, phân tách bằng dấu phẩy. Không chấp nhận "*".
# App Capacitor: Android = https://localhost, iOS = capacitor://localhost
CORS_ORIGIN=http://localhost:3000,http://localhost:3004,http://localhost:5173,https://localhost,capacitor://localhost

# XÁC THỰC: production luôn bắt buộc JWT. Dev mặc định cho khách ẩn danh (AUTH_REQUIRED=false).
# Sinh secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Muối HMAC băm IP trong nhật ký bảo mật audit_events (production bắt buộc, ≥ 32 ký tự, KHÁC JWT_SECRET;
# không đổi khi xoay JWT_SECRET lúc xử lý sự cố). Sinh như JWT_SECRET. Xem docs/van-hanh/SU-CO-LO-DU-LIEU.md
AUDIT_IP_SALT=
# Dự án 3 — đăng nhập mật khẩu/OTP. Pepper HMAC cho mã OTP email + bộ đếm giới hạn (production bắt buộc, ≥ 32 ký tự,
# KHÁC JWT_SECRET và AUDIT_IP_SALT). Dev/test để trống => sinh ngẫu nhiên mỗi lần chạy.
AUTH_OTP_PEPPER=
# Gửi mail: none (mặc định, quên mật khẩu chỉ dùng mã dự phòng) | gmail-smtp (cần mật khẩu ứng dụng Gmail — chỉ ở server)
MAIL_PROVIDER=none
MAIL_FROM=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_DAILY_CAP=450
# Thư/người/ngày ở luồng gắn email (tối thiểu 1; 0 bị từ chối) và tỉ lệ trần chung dành riêng cho quên mật khẩu (0–0.9)
MAIL_USER_DAILY_CAP=5
MAIL_RESET_RESERVE_RATIO=0.2
# Hạn mức AI của khách = hệ số × hạn mức tài khoản thật
GUEST_QUOTA_FACTOR=0.5
AUTH_REQUIRED=false
RATE_LIMIT_PER_MINUTE=60
AUDIO_BODY_LIMIT_MB=8

# CƠ SỞ DỮ LIỆU POSTGRESQL & BỘ NHỚ ĐỆM REDIS
DATABASE_URL=postgresql://postgres:password@localhost:5432/vietlearning?sslmode=require
REDIS_URL=redis://default:password@localhost:6379

# LƯU TRỮ TẬP TIN ÂM THANH CLOUDFLARE R2 (S3-COMPATIBLE)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_cloudflare_r2_access_key
S3_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
S3_BUCKET_NAME=vietlearning-audio-cache
S3_PUBLIC_DOMAIN=https://audio.vietlearning.app

# CÁC DỊCH VỤ TRÍ TUỆ NHÂN TẠO (AI SERVICES)
# Khuyên dùng: đặt khóa ở %USERPROFILE%\.becutit\gateway.env (ngoài repo, dùng chung mọi checkout/worktree)
GEMINI_API_KEY=
# Model mặc định gemini-3.5-flash-lite. Không đặt khóa => Gateway dùng bộ giả lập (mock: true)
GEMINI_MODEL=
LLM_TIMEOUT_MS=8000

# CHUỖI DỰ PHÒNG AI (xem docs/van-hanh/AI-CHUOI-DU-PHONG.md) — thử từ trái sang phải; 429/5xx/timeout/JSON sai => nguồn kế.
# Cú pháp: nhà_cung_cấp[:model] cách nhau bằng dấu phẩy. Không đặt => "gemini" nếu có GEMINI_API_KEY, không thì bộ giả lập.
# Mục thiếu khóa bị bỏ qua (có cảnh báo). Hết chuỗi => 503 llm_busy (không trừ lượt người dùng).
# Thứ tự đề xuất (đo thật 20/11): nguồn NHANH đứng trước. Groq trả lời ~0,7–1 s; Gemini free hôm đó 1–7 s (kể cả prompt 20 token) và hay 503.
# Groq free chỉ 8 000 token/phút (prompt gia sư ≈ 3 000 token/lượt ⇒ chỉ vài lượt/phút) nên Gemini phải nằm sau làm dự phòng.
LLM_CHAIN=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,gemini
# Ảnh trong chat / gọi video / Camera: Gemini hay 503 nên dự phòng MIỄN PHÍ đã thử thật 22/11/2026 (VISION-DP):
# Groq qwen/qwen3.8-27b (nhanh 0,5–2 s, free 8 000 token/phút, mỗi ảnh ≈ 2 048 token ⇒ chỉ vài ảnh/phút) rồi OpenRouter gemma-4-31b (hay 429 "rate-limited upstream"), nemotron-3.5-super-vl (ổn định, 2,5–7 s).
# Không đặt VISION_CHAIN => tự dùng đúng chuỗi này theo khóa đang có.
VISION_CHAIN=gemini,groq:qwen/qwen3.8-27b,openrouter:google/gemma-4-31b-it:free,openrouter:nvidia/nemotron-3.5-super-vl:free
# Whisper large-v3-turbo của Groq nhận đúng câu tiếng Việt mẫu trong ~1 s; Gemini STT timeout 8 s khi bận
STT_CHAIN=groq:whisper-large-v3-turbo,gemini
# Khóa các nhà cung cấp kiểu OpenAI-compatible (chỉ ở server; khuyên đặt ở %USERPROFILE%\.becutit\gateway.env)
OPENROUTER_API_KEY=
GROQ_API_KEY=
NOUS_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Nhà cung cấp khác: <TÊN>_BASE_URL + <TÊN>_API_KEY rồi dùng "ten:model" trong chuỗi. Chế độ JSON: <TÊN>_JSON_MODE=json_object|json_schema|none
# Ngắt mạch tạm sau 429 (ms), tổng thời gian cho cả chuỗi và thời gian chừa cho mỗi nguồn dự phòng phía sau
AI_BREAKER_MS=180000
LLM_CHAIN_BUDGET_MS=9000
AI_CHAIN_RESERVE_MS=3000
OPENAI_API_KEY=sk-proj-...
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=southeastasia
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# HẠN MỨC QUOTA MỖI NGÀY TRÊN MỖI NGƯỜI DÙNG (PER-USER DAILY QUOTA)
MAX_STT_SECONDS_PER_DAY=600
MAX_TTS_CHARS_PER_DAY=15000
MAX_LLM_TOKENS_PER_DAY=100000
MAX_CHAT_TURNS_PER_DAY=60
# Ngày hạn mức đổi lúc 00:00 GIỜ VIỆT NAM (17:00 UTC), không phải nửa đêm UTC.
# TRẦN DÙNG CHUNG CẢ APP mỗi ngày (0 = tắt), để cả app không đốt hết hạn mức miễn phí của nhà cung cấp
GLOBAL_MAX_TURNS_PER_DAY=2000
GLOBAL_MAX_LLM_TOKENS_PER_DAY=4000000
GLOBAL_MAX_STT_SECONDS_PER_DAY=28800
GLOBAL_MAX_VISION_PER_DAY=500
AUDIO_TTL_DAYS=30

# TRANG QUẢN TRỊ /admin/v1 (dự án 5a) — chỉ TÊN biến, KHÔNG ghi giá trị thật vào tệp này (repo công khai); đặt giá trị ở ~/.becutit/gateway.env hoặc biến môi trường server
# ADMIN_API_ENABLED mặc định: TẮT ở production, BẬT ở dev. ADMIN_ORIGIN = nguồn CORS duy nhất của /admin/v1 (/v1 không bao giờ nhận nguồn này)
ADMIN_API_ENABLED=
ADMIN_ORIGIN=http://localhost:5180
# Khóa AES-256-GCM cho bí mật TOTP: đúng 32 byte, hex (64 ký tự) hoặc base64. Sinh: node -e "console.log(require(`crypto`).randomBytes(32).toString(`hex`))". KHÔNG đổi sau khi đã có người đăng ký mã 6 số
ADMIN_MFA_KEY=
# Khóa ký access JWT quản trị (≥ 32 ký tự, KHÁC JWT_SECRET/AUDIT_IP_SALT/AUTH_OTP_PEPPER). Thiếu ADMIN_MFA_KEY hoặc khóa này => /admin/v1 trả 503 admin_disabled
ADMIN_JWT_SECRET=
# Khóa HMAC ký URL tệp đính kèm cho quản trị (≥ 32 ký tự, KHÁC mọi khóa trên). Thiếu => cấp URL tệp và /admin/v1/blob trả 503 admin_disabled
ADMIN_BLOB_URL_SECRET=
# URL tệp ký lấy gốc từ PUBLIC_BASE_URL; production PHẢI đặt PUBLIC_BASE_URL (không thì lấy từ header Host của yêu cầu)
# Giới hạn theo IP mỗi phút: route quản trị đã đăng nhập (mặc định 120) và /admin/v1/blob (mặc định 60)
# ADMIN_API_RATE_LIMIT_PER_MINUTE=120
# ADMIN_BLOB_RATE_LIMIT_PER_MINUTE=60

# GÓP Ý / BÁO LỖI (dự án 5a): kho tệp đính kèm. Chỉ tên biến, không đặt khóa ở đây.
BLOB_PROVIDER=fs
# BLOB_DIR mặc định ~/.becutit/blobs (ngoài repo)
BLOB_TOTAL_CAP_MB=8000
FEEDBACK_IP_PER_HOUR=20

# BẠN BÈ (dự án 4): chat, gọi, nhóm. Chỉ TÊN biến; khóa thật ở ~/.becutit/gateway.env hoặc secret CI, KHÔNG commit.
# CHAT_ENABLED: mặc định false ở production, true ở dev/test. CHAT_RATE_LIMIT_PER_MINUTE: trần yêu cầu/phút/người của route chat (mặc định 600).
CHAT_ENABLED=
CHAT_RATE_LIMIT_PER_MINUTE=600
# /ws chỉ đăng ký khi CHAT_ENABLED bật. WS_RATE_LIMIT_PER_MINUTE = giới hạn nối /ws theo IP (mặc định 30).
WS_RATE_LIMIT_PER_MINUTE=
CHAT_BLOB_TOTAL_CAP_MB=5000
CHAT_BLOB_URL_SECRET=
GROUP_SOFT_CAP=1000
PUBLIC_WEB_ORIGIN=
PUSH_PROVIDER=none
FCM_SERVICE_ACCOUNT_FILE=
TURN_PROVIDER=none
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
STUN_URLS=
TURN_STATIC_URLS=
TURN_STATIC_USER=
TURN_STATIC_CREDENTIAL=
TURN_MONTHLY_BUDGET_GB=800
CALL_MAX_PARTICIPANTS=6
