# ==============================================================================
# HỆ THỐNG AGENTIC VIETNAMESE LEARNING - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# TỆP MẪU: không chứa khóa thật và KHÔNG cần sao chép để chạy thử. Gateway chạy được khi không có tệp .env nào
# (chế độ giả lập, CSDL PGlite nhúng). Chỉ đặt biến nào bạn cần đổi.
#
# Nơi Gateway đọc cấu hình (biến đã có thì không bị ghi đè; xem apps/gateway/src/config.ts):
#   1) biến môi trường của tiến trình
#   2) tệp .env trong thư mục Gateway (apps/gateway/.env, hoặc 01-nen-tang/apps/gateway/.env sau khi tách 4 thư mục) — đã gitignore
#   3) %USERPROFILE%\.becutit\gateway.env (macOS/Linux: ~/.becutit/gateway.env) — NGOÀI repo; đổi vị trí bằng BECUTIT_ENV_FILE
# KHÓA AI: đặt ở (3) bằng  node scripts/nhom/tao-env.mjs  (hỏi từng khóa, gõ ẩn). Hướng dẫn: docs/nhom/CAI-DAT.md
# ==============================================================================

# CỔNG GATEWAY
NODE_ENV=development
PORT=4000
# Danh sách origin được phép gọi Gateway, phân tách bằng dấu phẩy. Không chấp nhận "*".
# App Capacitor: Android = https://localhost, iOS = capacitor://localhost
CORS_ORIGIN=http://localhost:3000,http://localhost:3004,http://localhost:5173,https://localhost,capacitor://localhost

# XÁC THỰC: người học nhận tài khoản khách qua /v1/auth/guest. Dev/test để TRỐNG JWT_SECRET, AUDIT_IP_SALT, AUTH_OTP_PEPPER
# => Gateway tự sinh ngẫu nhiên mỗi lần chạy. PRODUCTION BẮT BUỘC đặt cả ba (≥ 32 ký tự, khác nhau).
# Sinh secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Muối HMAC băm IP trong nhật ký bảo mật audit_events (production bắt buộc, ≥ 32 ký tự, KHÁC JWT_SECRET;
# không đổi khi xoay JWT_SECRET lúc xử lý sự cố). Sinh như JWT_SECRET. Xem docs/van-hanh/SU-CO-LO-DU-LIEU.md
AUDIT_IP_SALT=
# Dự án 3 — đăng nhập mật khẩu/OTP. Pepper HMAC cho mã OTP email + bộ đếm giới hạn (production bắt buộc, ≥ 32 ký tự,
# KHÁC JWT_SECRET và AUDIT_IP_SALT). Dev/test để trống => sinh ngẫu nhiên mỗi lần chạy.
AUTH_OTP_PEPPER=
# AUTH_REQUIRED mặc định BẬT ở mọi môi trường. Chỉ đặt false cho test cô lập (người dùng ẩn danh) — app thật cần bật.
# AUTH_REQUIRED=true

# Gửi mail: none (mặc định, quên mật khẩu chỉ dùng mã dự phòng) | gmail-smtp (cần mật khẩu ứng dụng Gmail — chỉ ở server)
MAIL_PROVIDER=none
MAIL_FROM=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_DAILY_CAP=450
# Hạn mức AI của khách = hệ số × hạn mức tài khoản thật
GUEST_QUOTA_FACTOR=0.5
RATE_LIMIT_PER_MINUTE=60
AUDIO_BODY_LIMIT_MB=8

# CƠ SỞ DỮ LIỆU
# KHÔNG đặt DATABASE_URL khi phát triển: Gateway dùng PGlite nhúng (dữ liệu ở apps/gateway/.data, đã gitignore).
# Chỉ đặt DATABASE_URL (Postgres thật, vd. Neon) khi triển khai. Dòng dưới là ví dụ — giữ dạng chú thích, đừng bỏ dấu # trên máy dev
# (nếu không Gateway sẽ cố nối Postgres và báo lỗi).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Tùy chọn: thư mục dữ liệu PGlite, hoặc memory:// (mất dữ liệu khi tắt — hợp để thử)
# PGLITE_DIR=memory://
# (Đã bỏ REDIS_URL, S3_*, AUDIO_TTL_DAYS, OPENAI_API_KEY, AZURE_SPEECH_*, GOOGLE_APPLICATION_CREDENTIALS: mã hiện tại không đọc các biến này.)

# CÁC DỊCH VỤ TRÍ TUỆ NHÂN TẠO (AI SERVICES)
# Không đặt khóa nào => Gateway dùng bộ giả lập (mock: true), vẫn chạy được mọi màn. Để TRỐNG ở tệp này; điền khóa ở tệp (3)
# bằng node scripts/nhom/tao-env.mjs. Khóa miễn phí: Gemini https://aistudio.google.com/apikey · Groq https://console.groq.com/keys ·
# OpenRouter https://openrouter.ai/keys
GEMINI_API_KEY=
# Model mặc định gemini-3.5-flash-lite
GEMINI_MODEL=
LLM_TIMEOUT_MS=8000

# CHUỖI DỰ PHÒNG AI (xem docs/van-hanh/AI-CHUOI-DU-PHONG.md) — thử từ trái sang phải; 429/5xx/timeout/JSON sai => nguồn kế.
# Cú pháp: nhà_cung_cấp[:model] cách nhau bằng dấu phẩy. Không đặt => "gemini" nếu có GEMINI_API_KEY, không thì bộ giả lập.
# Mục thiếu khóa bị bỏ qua (có cảnh báo). Hết chuỗi => 503 llm_busy (không trừ lượt người dùng).
# node scripts/nhom/tao-env.mjs tự sinh LLM_CHAIN/STT_CHAIN theo khóa bạn có; chỉ đặt tay khi cần. Giữ dạng chú thích:
# Thứ tự đề xuất (đo thật 20/11): nguồn NHANH đứng trước. Groq trả lời ~0,7–1 s; Gemini free hôm đó 1–7 s và hay 503.
# Groq free chỉ 8 000 token/phút (prompt gia sư ≈ 3 000 token/lượt ⇒ chỉ vài lượt/phút) nên Gemini nằm sau làm dự phòng.
# LLM_CHAIN=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,gemini
# Ảnh trong chat / gọi video / Camera: không đặt VISION_CHAIN => tự dùng Gemini + Groq + OpenRouter theo khóa đang có.
# VISION_CHAIN=gemini,groq:qwen/qwen3.8-27b,openrouter:google/gemma-4-31b-it:free,openrouter:nvidia/nemotron-3.5-super-vl:free
# Whisper large-v3-turbo của Groq nhận đúng câu tiếng Việt mẫu trong ~1 s; Gemini STT timeout 8 s khi bận
# STT_CHAIN=groq:whisper-large-v3-turbo,gemini
# Khóa các nhà cung cấp kiểu OpenAI-compatible (chỉ ở server; điền ở tệp (3), KHÔNG điền vào tệp này)
OPENROUTER_API_KEY=
GROQ_API_KEY=
NOUS_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Nhà cung cấp khác: <TÊN>_BASE_URL + <TÊN>_API_KEY rồi dùng "ten:model" trong chuỗi. Chế độ JSON: <TÊN>_JSON_MODE=json_object|json_schema|none
# Ngắt mạch tạm sau 429 (ms), tổng thời gian cho cả chuỗi và thời gian chừa cho mỗi nguồn dự phòng phía sau
AI_BREAKER_MS=180000
LLM_CHAIN_BUDGET_MS=9000
AI_CHAIN_RESERVE_MS=3000

# HẠN MỨC QUOTA MỖI NGÀY TRÊN MỖI NGƯỜI DÙNG (PER-USER DAILY QUOTA)
MAX_STT_SECONDS_PER_DAY=600
MAX_TTS_CHARS_PER_DAY=15000
MAX_LLM_TOKENS_PER_DAY=100000
MAX_CHAT_TURNS_PER_DAY=60
# Ngày hạn mức đổi lúc 00:00 GIỜ VIỆT NAM (17:00 UTC), không phải nửa đêm UTC.
# TRẦN DÙNG CHUNG CẢ APP mỗi ngày (0 = tắt), để cả app không đốt hết hạn mức miễn phí của nhà cung cấp
GLOBAL_MAX_TURNS_PER_DAY=2000
GLOBAL_MAX_LLM_TOKENS_PER_DAY=4000000
GLOBAL_MAX_STT_SECONDS_PER_DAY=28800
GLOBAL_MAX_VISION_PER_DAY=500
