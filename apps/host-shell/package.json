{
  "name": "@vietlearning/host-shell",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:run": "vite build && cap run android",
    "android:apk:win": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "test": "vitest run",
    "size": "size-limit",
    "e2e": "playwright test",
    "perf": "node scripts/lighthouse.mjs",
    "android:release:win": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Release"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@vietlearning/api-client": "workspace:*",
    "@vietlearning/content": "workspace:*",
    "@vietlearning/contracts": "workspace:*",
    "@vietlearning/mfe-conversation": "workspace:*",
    "@vietlearning/mfe-knowledge": "workspace:*",
    "@vietlearning/mfe-learner": "workspace:*",
    "@vietlearning/mfe-practice": "workspace:*",
    "@vietlearning/mfe-speech-lab": "workspace:*",
    "@vietlearning/mfe-vision": "workspace:*",
    "@vietlearning/native": "workspace:*",
    "@vietlearning/shared": "workspace:*",
    "@vietlearning/state": "workspace:*",
    "@vietlearning/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.6.0",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
